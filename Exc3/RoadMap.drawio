        <mxCell id="fP5PYghc3A0w4Yy5Se03-13" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;Реализация каталога данных&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Интеграция каталога с сервисом аналитики&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;ETL для ИИ данных&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;ETL для фин. данных&lt;br&gt;Интеграция ИИ сервиса с каталогом&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
